---
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import { t } from '../i18n/index.js';
import { langHref } from '../lib/nav.js';
import { categoryName } from '../data/taxonomy.js';
import { relatedGames } from '../data/loader.js';

const { lang, game } = Astro.props;
const href = (p) => langHref(lang, p);
const title = game.title[lang] || game.title.en;
const summary = game.summary[lang] || game.summary.en;
const desc = (game.description && (game.description[lang] || game.description.en)) || summary;
const howto = game.howto[lang] || game.howto.en;
const tip = game.tip && (game.tip[lang] || game.tip.zh);
const related = relatedGames(game.slug, 3);
const playable = game.fetched && game.entry;
const hasExternal = !!game.play;

// Structured data for search engines & AI answer engines.
const repoOwner = (game.repo || '').replace(/^https?:\/\/github\.com\//, '').split('/')[0] || game.slug;
const otherLangName = (game.title[lang === 'zh' ? 'en' : 'zh'] || '').trim();
// Cover image (optional): og:image activates automatically once B3 drops
// files into site/public/covers/<slug>.png.
import fs from 'node:fs';
const coverPath = new URL(`../../public/covers/${game.slug}.png`, import.meta.url);
const cover = fs.existsSync(coverPath) ? `/covers/${game.slug}.png` : '';

const gameJsonld = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: title,
  ...(otherLangName && otherLangName !== title ? { alternateName: otherLangName } : {}),
  description: desc,
  url: Astro.url.href,
  ...(cover ? { image: new URL(cover, Astro.url).href } : {}),
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  genre: (game.categories || []).map((c) => categoryName(lang, c) || c),
  gamePlatform: 'Web browser',
  operatingSystem: 'Any (HTML5)',
  applicationCategory: 'Game',
  playMode: 'SinglePlayer',
  isAccessibleForFree: true,
  author: { '@type': 'Person', name: repoOwner, url: `https://github.com/${repoOwner}` },
  ...(game.license ? { license: `https://spdx.org/licenses/${game.license}.html` } : {}),
  keywords: (game.tags || []).join(', '),
  ...(game.added ? { datePublished: game.added } : {}),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
const breadcrumbJsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(lang, 'siteName'), item: new URL(href('/'), Astro.url).href },
    { '@type': 'ListItem', position: 2, name: t(lang, 'nav_games'), item: new URL(href('/games'), Astro.url).href },
    { '@type': 'ListItem', position: 3, name: title, item: Astro.url.href },
  ],
};

// FAQ: visible text mirrored as FAQPage JSON-LD — the format AI answer engines
// extract most reliably.
const zh = lang === 'zh';
const faq = [
  {
    q: zh ? `${title} 免费吗？` : `Is ${title} free to play?`,
    a: zh
      ? `免费。${title} 完全免费，打开浏览器即玩，无需安装或注册账号。`
      : `Yes. ${title} is completely free, runs in your browser, and needs no install or account.`,
  },
  {
    q: zh ? `${title} 是开源的吗？` : `Is ${title} open source?`,
    a: zh
      ? `是。收录的是 ${repoOwner} 的原版开源代码，采用 ${game.license || '开源'} 协议，源码见 ${game.repo}。`
      : `Yes. It hosts the original open-source code by ${repoOwner}, released under ${game.license || 'an open-source license'}. Source: ${game.repo}`,
  },
  {
    q: zh ? `${title} 怎么玩？` : `How do you play ${title}?`,
    a: zh ? (howto || '鼠标或键盘操作，具体见页面说明。') : (howto || 'Mouse or keyboard controls; see the page for details.'),
  },
];
const faqJsonld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base lang={lang} title={title} description={summary} currentPath={Astro.url.pathname} image={cover} jsonld={[gameJsonld, breadcrumbJsonld, faqJsonld]}>
  <article class="detail">
    <a class="back-link" href={href('/games')}>← {t(lang, 'back_to_list')}</a>
    <div class="detail-head">
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
      <div class="cat-line">
        {(game.categories || []).map((c) => (
          <a class="pill pill-cat" href={href('/categories/' + c)}>{categoryName(lang, c)}</a>
        ))}
      </div>
    </div>

    {playable ? (
      <div class="player-shell">
        <div class="player-toolbar">
          <span class="hint">{howto}</span>
          <a class="btn" href={game.entry} target="_blank" rel="noopener">{t(lang, 'fullscreen')} ↗</a>
        </div>
        <iframe class="player" src={game.entry} title={title} allow="fullscreen; autoplay; gamepad" loading="lazy"></iframe>
      </div>
    ) : hasExternal ? (
      <div class="player-shell">
        <div class="player-toolbar">
          <span class="hint">{howto}</span>
        </div>
        <div class="play-external">
          <a class="btn btn-primary" href={game.play} target="_blank" rel="noopener">▶ {lang === 'zh' ? '在线试玩' : 'Play online'} ↗</a>
          <a class="btn" href={game.repo} target="_blank" rel="noopener">{lang === 'zh' ? 'GitHub 仓库' : 'GitHub repo'}</a>
        </div>
      </div>
    ) : (
      <div class="player-shell">
        <div class="play-external">
          <span class="coming-soon">{t(lang, 'coming_soon')}</span>
          <a class="btn" href={game.repo} target="_blank" rel="noopener">{lang === 'zh' ? '查看源码' : 'View source'} ↗</a>
        </div>
      </div>
    )}

    <section class="meta-grid">
      <div><h4>{t(lang, 'meta_source')}</h4><a href={game.repo} target="_blank" rel="noopener">{(game.repo||'').replace('https://github.com/','')}</a></div>
      <div><h4>{t(lang, 'meta_license')}</h4><span>{game.license}</span></div>
      <div><h4>{t(lang, 'meta_stars')}</h4><span>★ {(game.stars||0).toLocaleString()}</span></div>
      <div><h4>{lang==='zh'?'体积':'Size'}</h4><span>{game.size||'—'}</span></div>
      <div><h4>{lang==='zh'?'技术栈':'Tech'}</h4><span>{(game.tech||[]).join(' · ')}</span></div>
      <div><h4>{lang==='zh'?'部署':'Deploy'}</h4><span>{game.server ? (lang==='zh'?'需服务端':'Needs server') : (lang==='zh'?'纯静态':'Static')}</span></div>
    </section>

    <section class="desc">
      <h3>{t(lang, 'meta_title')}</h3>
      <p>{desc}</p>
      {howto && <p class="controls">{howto}</p>}
      {tip && <div class="tip-box"><h4>{lang==='zh'?'接入建议':'Integration notes'}</h4><p>{tip}</p></div>}
      <div class="tags">
        {(game.tags || []).map((tg) => <span class="pill">#{tg}</span>)}
      </div>
    </section>

    <section class="desc faq">
      <h3>{zh ? '常见问题' : 'FAQ'}</h3>
      {faq.map((f) => <div class="faq-item"><h4>{f.q}</h4><p>{f.a}</p></div>)}
    </section>

    {related.length > 0 && (
      <section>
        <div class="section-head"><h2>{t(lang, 'related')}</h2></div>
        <div class="card-grid">
          {related.map((g) => <GameCard lang={lang} game={g} />)}
        </div>
      </section>
    )}
  </article>
</Base>
