# ⚠️ Copy this file to `.env` (or `.env.production` for builds) and fill in your
# real values. The `.env` file is in .gitignore — never commit secrets.

# ──────────────────────────────────────────────────────────────
# REQUIRED for production builds
# All absolute URLs (canonical / sitemap / hreflang / og: / robots / llms.txt)
# are derived from this. Must include scheme, no trailing slash.
#
# Dev/local: omit PUBLIC_SITE — it defaults to http://localhost:4321
# Production:
PUBLIC_SITE=https://game.wuqingbao.com

# ──────────────────────────────────────────────────────────────
# OPTIONAL: Umami (self-hosted / cloud) analytics.
# The script tag is only injected on PROD builds when BOTH vars are set.
# Leave blank (= disabled) in local dev / preview environments so test traffic
# does not pollute your real stats.
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_ID=

# Example for Umami Cloud:
#   PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
#   PUBLIC_UMAMI_ID=a3ef9a6e-09b6-41c2-8643-c66a4f71b4da
#
# Example for self-hosted Umami on the same origin's subdomain:
#   PUBLIC_UMAMI_SRC=https://stats.game.wuqingbao.com/script.js
#   PUBLIC_UMAMI_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ──────────────────────────────────────────────────────────────
# OPTIONAL: Google AdSense.
# The Google AdSense loader script is injected ONLY on PRODUCTION builds
# when this env var starts with "ca-pub-". Leave it blank in non-production
# environments so local / preview traffic doesn't accidentally load ads
# (which would pollute verification traffic and waste ad quota).
#
# Example:
#   PUBLIC_ADSENSE_CLIENT=ca-pub-8742597051941928
PUBLIC_ADSENSE_CLIENT=
